<Window
    x:Class="StickyNotes.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sticky Notes">

    <Grid Background="#101112">
        <Grid.RowDefinitions>
            <!-- Custom In-App TitleBar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content View -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Clean TitleBar -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="40"
            Background="#18191A"
            BorderBrush="#15FFFFFF"
            BorderThickness="0,0,0,1"
            Padding="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand: Icon + Sticky Notes -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="#F5C542" />
                <TextBlock Text="Sticky Notes" FontWeight="SemiBold" FontSize="13" Foreground="White" />
            </StackPanel>

            <!-- Right Controls: Settings Button with margin from window caption controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,140,0">
                <Button
                    x:Name="TopSettingsButton"
                    Click="OnOpenSettingsClick"
                    Height="28"
                    Padding="10,0"
                    Background="#252627"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="1"
                    CornerRadius="4"
                    ToolTipService.ToolTip="Settings">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontSize="11" Foreground="#CCCCCC" />
                        <TextBlock Text="Settings" FontSize="11" Foreground="#EEEEEE" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Frame x:Name="ContentFrame" Grid.Row="1" />
    </Grid>
</Window>
