<Page
    x:Class="StickyNotes.Views.NotesHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:StickyNotes.Views.Converters"
    xmlns:controls="using:StickyNotes.Views.Controls"
    xmlns:models="using:StickyNotes.Core.Models.Note"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NoteBackgroundConverter x:Key="NoteBgConv" />
        <converters:NoteBorderConverter x:Key="NoteBorderConv" />
        <converters:NoteHeaderConverter x:Key="NoteHdrConv" />
        <converters:NoteAccentConverter x:Key="NoteAccentConv" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConv" />

        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Page.Resources>

    <Grid Background="#121314">
        <!-- Main Workspace: Split into Hub (Left) and Floating Note Pane (Right) -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="340" MaxWidth="380" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- 1. MAIN STICKY NOTES HUB (Left Area)                      -->
        <!-- ========================================================= -->
        <Grid Grid.Column="0" Background="#181818">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Command Bar / Search & Primary Actions -->
            <Grid Grid.Row="0" Background="#232323" Padding="14,10" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Action button: New note -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button
                        Click="OnNewNoteClick"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="34"
                        Padding="14,0"
                        CornerRadius="5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="New note" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- SearchBox -->
                <Grid Grid.Column="1" Margin="14,0,0,0" MaxWidth="360" HorizontalAlignment="Left">
                    <TextBox
                        x:Name="SearchBox"
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Search notes and snippets..."
                        Height="34"
                        FontSize="12"
                        Background="#2A2A2A"
                        BorderBrush="#1AFFFFFF"
                        CornerRadius="5"
                        VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Workspace Body: Sidebar + Notes Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Sidebar -->
                <Grid Grid.Column="0" Background="#1B1B1B" BorderBrush="#12FFFFFF" BorderThickness="0,0,1,0" Padding="10,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="3">
                            <!-- Primary Category Filters -->
                            <Button Click="OnFilterNavClick" Tag="all" Style="{StaticResource SidebarNavButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8C0;" FontSize="12" Foreground="#CCCCCC" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="All Notes" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.AllCount, Mode=OneWay}" FontSize="11" Foreground="#777777" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button Click="OnFilterNavClick" Tag="pinned" Style="{StaticResource SidebarNavButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE718;" FontSize="12" Foreground="#CE93D8" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="Pinned" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.PinnedCount, Mode=OneWay}" FontSize="11" Foreground="#777777" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button Click="OnFilterNavClick" Tag="trash" Style="{StaticResource SidebarNavButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#FF8888" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="Trash" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.TrashCount, Mode=OneWay}" FontSize="11" Foreground="#777777" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Border Height="1" Background="#15FFFFFF" Margin="6,8,6,8" />

                            <!-- COLORS SECTION -->
                            <TextBlock Text="COLORS" FontSize="10" FontWeight="Bold" Foreground="#666666" Margin="6,2,0,6" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,2,0,0">
                                <Button Click="OnColorFilterClick" Tag="yellow" Width="20" Height="20" CornerRadius="10" Background="#F5C542" BorderBrush="#F5C542" Padding="0" ToolTipService.ToolTip="Yellow" />
                                <Button Click="OnColorFilterClick" Tag="blue" Width="20" Height="20" CornerRadius="10" Background="#60CDFF" BorderBrush="#60CDFF" Padding="0" ToolTipService.ToolTip="Blue" />
                                <Button Click="OnColorFilterClick" Tag="green" Width="20" Height="20" CornerRadius="10" Background="#6CCF8E" BorderBrush="#6CCF8E" Padding="0" ToolTipService.ToolTip="Green" />
                                <Button Click="OnColorFilterClick" Tag="pink" Width="20" Height="20" CornerRadius="10" Background="#F48FB1" BorderBrush="#F48FB1" Padding="0" ToolTipService.ToolTip="Pink" />
                                <Button Click="OnColorFilterClick" Tag="purple" Width="20" Height="20" CornerRadius="10" Background="#CE93D8" BorderBrush="#CE93D8" Padding="0" ToolTipService.ToolTip="Purple" />
                                <Button Click="OnColorFilterClick" Tag="gray" Width="20" Height="20" CornerRadius="10" Background="#888890" BorderBrush="#888890" Padding="0" ToolTipService.ToolTip="Gray" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Notes Grid Container -->
                <Grid Grid.Column="1" Padding="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CurrentCategoryTitle, Mode=OneWay}" FontWeight="Bold" FontSize="15" Foreground="White" />
                            <Border Background="#2560CDFF" BorderBrush="#4060CDFF" BorderThickness="1" CornerRadius="10" Padding="8,2" Visibility="{x:Bind ViewModel.HasActiveFilter, Mode=OneWay, Converter={StaticResource BoolToVisConv}}">
                                <TextBlock Text="Filter Active" FontSize="10" Foreground="#60CDFF" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Cards ScrollViewer -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <GridView
                            ItemsSource="{x:Bind ViewModel.DisplayedNotes, Mode=OneWay}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="OnNoteCardItemClick">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GridViewItem">
                                                <ContentPresenter
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:NoteModel">
                                    <Border
                                        Width="320"
                                        MinHeight="160"
                                        Margin="0,0,14,14"
                                        Background="{x:Bind ColorTheme, Mode=OneWay, Converter={StaticResource NoteBgConv}}"
                                        BorderBrush="{x:Bind ColorTheme, Mode=OneWay, Converter={StaticResource NoteBorderConv}}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12">
                                        <Grid RowDefinitions="Auto,*">
                                            <!-- Card Action Buttons -->
                                            <Grid Grid.Row="0" Margin="0,0,0,2">
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Spacing="2">
                                                    <Button
                                                        Click="OnCardPinClick"
                                                        Tag="{x:Bind}"
                                                        Width="24"
                                                        Height="24"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="{x:Bind PinToolTip, Mode=OneWay}">
                                                        <FontIcon Glyph="{x:Bind PinGlyph, Mode=OneWay}" FontSize="12" Foreground="{x:Bind ColorTheme, Mode=OneWay, Converter={StaticResource NoteAccentConv}}" Opacity="{x:Bind PinOpacity, Mode=OneWay}" />
                                                    </Button>

                                                    <Button
                                                        Click="OnCardCopyAllClick"
                                                        Tag="{x:Bind}"
                                                        Width="24"
                                                        Height="24"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="Copy entire note">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="#CCCCCC" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Unified Sequential Blocks List -->
                                            <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Snippets, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SnippetBoxModel">
                                                        <Grid Margin="0,0,0,4">
                                                            <!-- Title Block -->
                                                            <TextBlock
                                                                Text="{x:Bind DisplayContent, Mode=OneWay}"
                                                                FontWeight="Bold"
                                                                FontSize="13"
                                                                Foreground="White"
                                                                TextTrimming="CharacterEllipsis"
                                                                Margin="0,0,0,4"
                                                                Visibility="{x:Bind IsTitle, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" />

                                                            <!-- Description Block -->
                                                            <TextBlock
                                                                Text="{x:Bind DisplayContent, Mode=OneWay}"
                                                                FontSize="11.5"
                                                                Foreground="#DDDDDD"
                                                                TextWrapping="Wrap"
                                                                MaxLines="3"
                                                                TextTrimming="CharacterEllipsis"
                                                                Margin="0,0,0,4"
                                                                Visibility="{x:Bind IsDescription, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" />

                                                            <!-- Separator -->
                                                            <Border
                                                                Height="1"
                                                                Background="#15FFFFFF"
                                                                Margin="0,3,0,4"
                                                                Visibility="{x:Bind IsSeparator, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" />

                                                            <!-- Label -->
                                                            <TextBlock
                                                                Text="{x:Bind DisplayContent, Mode=OneWay}"
                                                                FontWeight="SemiBold"
                                                                FontSize="11.5"
                                                                Foreground="White"
                                                                TextTrimming="CharacterEllipsis"
                                                                Margin="0,1,0,2"
                                                                Visibility="{x:Bind IsLabel, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" />

                                                            <!-- Snippet Box -->
                                                            <Border
                                                                Margin="0,0,0,2"
                                                                Background="{StaticResource SnippetBoxBgBrush}"
                                                                BorderBrush="{StaticResource SnippetBoxBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="5"
                                                                Padding="8,6"
                                                                Visibility="{x:Bind IsSnippet, Mode=OneWay, Converter={StaticResource BoolToVisConv}}">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock
                                                                        Grid.Column="0"
                                                                        Text="{x:Bind DisplayContent, Mode=OneWay}"
                                                                        FontFamily="{StaticResource CodeFontFamily}"
                                                                        FontSize="11"
                                                                        Foreground="#EEEEEE"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        MaxLines="2"
                                                                        VerticalAlignment="Center" />

                                                                    <controls:CopyIconButton
                                                                        Grid.Column="1"
                                                                        TextToCopy="{x:Bind Content, Mode=OneWay}"
                                                                        Margin="6,0,0,0"
                                                                        VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Column Splitter / Separator -->
        <Border Grid.Column="1" Width="1" Background="#15FFFFFF" />

        <!-- ====================================================================== -->
        <!-- 2. STICKY NOTE EDITOR PANE (Right Area)                                -->
        <!-- ====================================================================== -->
        <Border Grid.Column="2" Background="#202020">
            <controls:NoteEditorControl
                x:Name="HubEditorControl"
                Note="{x:Bind ViewModel.ActiveNote, Mode=OneWay}"
                IsFloatingMode="False"
                NewNoteRequested="OnNewNoteRequestedFromEditor"
                PopoutRequested="OnPopoutRequestedFromEditor"
                DeleteRequested="OnDeleteActiveNoteFromEditor"
                NoteSaved="OnActiveNoteSavedFromEditor" />
        </Border>
    </Grid>
</Page>
