<Page
    x:Class="StickyNotes.Views.NotesHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:StickyNotes.Views.Converters"
    xmlns:controls="using:StickyNotes.Views.Controls"
    xmlns:models="using:StickyNotes.Core.Models.Note"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NoteBackgroundConverter x:Key="NoteBgConv" />
        <converters:NoteBorderConverter x:Key="NoteBorderConv" />
        <converters:NoteHeaderConverter x:Key="NoteHdrConv" />
        <converters:NoteAccentConverter x:Key="NoteAccentConv" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConv" />

        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Page.Resources>

    <Grid Background="#121314">
        <!-- Main Workspace: Split into Hub (Left) and Floating Note Pane (Right) -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="340" MaxWidth="380" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- 1. MAIN STICKY NOTES HUB (Left Area)                      -->
        <!-- ========================================================= -->
        <Grid Grid.Column="0" Background="#181818">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Command Bar / Search & Primary Actions -->
            <Grid Grid.Row="0" Background="#232323" Padding="14,10" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Action button: New note -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button
                        Click="OnNewNoteClick"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="34"
                        Padding="14,0"
                        CornerRadius="5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="New note" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- SearchBox -->
                <Grid Grid.Column="1" Margin="14,0,0,0" MaxWidth="360" HorizontalAlignment="Left">
                    <TextBox
                        x:Name="SearchBox"
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Search notes and snippets..."
                        Height="34"
                        FontSize="12"
                        Background="#2A2A2A"
                        BorderBrush="#1AFFFFFF"
                        CornerRadius="5"
                        VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Workspace Body: Sidebar + Notes Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Sidebar -->
                <Grid Grid.Column="0" Background="#1B1B1B" BorderBrush="#12FFFFFF" BorderThickness="0,0,1,0" Padding="10,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="3">
                            <!-- NOTES SECTION -->
                            <TextBlock Text="NOTES" FontSize="10" FontWeight="Bold" Foreground="#666666" Margin="6,2,0,6" />

                            <!-- All Notes -->
                            <Button Click="OnFilterNavClick" Tag="all" Style="{StaticResource SidebarNavButtonStyle}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="#60CDFF" />
                                        <TextBlock Text="All Notes" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#20FFFFFF" CornerRadius="10" Padding="6,1">
                                        <TextBlock Text="{x:Bind ViewModel.AllCount, Mode=OneWay}" FontSize="10" Foreground="#AAAAAA" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Pinned -->
                            <Button Click="OnFilterNavClick" Tag="pinned" Style="{StaticResource SidebarNavButtonStyle}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE718;" FontSize="12" Foreground="#F5C542" />
                                        <TextBlock Text="Pinned" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#20FFFFFF" CornerRadius="10" Padding="6,1">
                                        <TextBlock Text="{x:Bind ViewModel.PinnedCount, Mode=OneWay}" FontSize="10" Foreground="#AAAAAA" />
                                    </Border>
                                </Grid>
                            </Button>

                            <MenuFlyoutSeparator Margin="0,8" />

                            <!-- TAGS SECTION -->
                            <TextBlock Text="TAGS" FontSize="10" FontWeight="Bold" Foreground="#666666" Margin="6,2,0,6" />

                            <!-- #Work Tag -->
                            <Button Click="OnFilterNavClick" Tag="work" Style="{StaticResource SidebarNavButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="11" Foreground="#60CDFF" />
                                    <TextBlock Text="#Work" />
                                </StackPanel>
                            </Button>

                            <!-- #Dev Tag -->
                            <Button Click="OnFilterNavClick" Tag="dev" Style="{StaticResource SidebarNavButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="11" Foreground="#60CDFF" />
                                    <TextBlock Text="#Dev" />
                                </StackPanel>
                            </Button>

                            <!-- #Personal Tag -->
                            <Button Click="OnFilterNavClick" Tag="personal" Style="{StaticResource SidebarNavButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="11" Foreground="#60CDFF" />
                                    <TextBlock Text="#Personal" />
                                </StackPanel>
                            </Button>

                            <MenuFlyoutSeparator Margin="0,8" />

                            <!-- COLORS SECTION -->
                            <TextBlock Text="COLORS" FontSize="10" FontWeight="Bold" Foreground="#666666" Margin="6,2,0,6" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,2,0,0">
                                <Button Click="OnColorFilterClick" Tag="yellow" Width="20" Height="20" CornerRadius="10" Background="#F5C542" BorderBrush="#F5C542" Padding="0" ToolTipService.ToolTip="Yellow" />
                                <Button Click="OnColorFilterClick" Tag="blue" Width="20" Height="20" CornerRadius="10" Background="#60CDFF" BorderBrush="#60CDFF" Padding="0" ToolTipService.ToolTip="Blue" />
                                <Button Click="OnColorFilterClick" Tag="green" Width="20" Height="20" CornerRadius="10" Background="#6CCF8E" BorderBrush="#6CCF8E" Padding="0" ToolTipService.ToolTip="Green" />
                                <Button Click="OnColorFilterClick" Tag="pink" Width="20" Height="20" CornerRadius="10" Background="#F48FB1" BorderBrush="#F48FB1" Padding="0" ToolTipService.ToolTip="Pink" />
                                <Button Click="OnColorFilterClick" Tag="purple" Width="20" Height="20" CornerRadius="10" Background="#CE93D8" BorderBrush="#CE93D8" Padding="0" ToolTipService.ToolTip="Purple" />
                                <Button Click="OnColorFilterClick" Tag="gray" Width="20" Height="20" CornerRadius="10" Background="#888890" BorderBrush="#888890" Padding="0" ToolTipService.ToolTip="Gray" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Notes Grid Container -->
                <Grid Grid.Column="1" Padding="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CurrentCategoryTitle, Mode=OneWay}" FontWeight="Bold" FontSize="15" Foreground="White" />
                            <Border Background="#2560CDFF" BorderBrush="#4060CDFF" BorderThickness="1" CornerRadius="10" Padding="8,2" Visibility="{x:Bind ViewModel.HasActiveFilter, Mode=OneWay, Converter={StaticResource BoolToVisConv}}">
                                <TextBlock Text="Filter Active" FontSize="10" Foreground="#60CDFF" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Cards ScrollViewer -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <GridView
                            ItemsSource="{x:Bind ViewModel.DisplayedNotes, Mode=OneWay}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="OnNoteCardItemClick">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:NoteModel">
                                    <Border
                                        Width="320"
                                        MinHeight="160"
                                        Margin="0,0,14,14"
                                        Background="{x:Bind ColorTheme, Mode=OneWay, Converter={StaticResource NoteBgConv}}"
                                        BorderBrush="{x:Bind ColorTheme, Mode=OneWay, Converter={StaticResource NoteBorderConv}}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12">
                                        <Grid RowDefinitions="Auto,*,Auto,Auto">
                                            <!-- Card Header: Display Title, Pin, Copy Note -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                                    FontWeight="Bold"
                                                    FontSize="13"
                                                    Foreground="White"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />

                                                <Button
                                                    Grid.Column="1"
                                                    Click="OnCardPinClick"
                                                    Tag="{x:Bind}"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    ToolTipService.ToolTip="Pin Note">
                                                    <FontIcon Glyph="&#xE718;" FontSize="11" Foreground="{x:Bind ColorTheme, Mode=OneWay, Converter={StaticResource NoteAccentConv}}" />
                                                </Button>

                                                <Button
                                                    Grid.Column="2"
                                                    Click="OnCardCopyAllClick"
                                                    Tag="{x:Bind}"
                                                    Height="22"
                                                    Padding="6,0"
                                                    Background="#15FFFFFF"
                                                    BorderThickness="0"
                                                    CornerRadius="3"
                                                    ToolTipService.ToolTip="Copy entire note">
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="8.5" Foreground="#CCCCCC" />
                                                        <TextBlock Text="Copy note" FontSize="9" Foreground="#CCCCCC" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- Content Preview Text -->
                                            <TextBlock
                                                Grid.Row="1"
                                                Text="{x:Bind Content, Mode=OneWay}"
                                                FontSize="11.5"
                                                Foreground="#DDDDDD"
                                                TextWrapping="Wrap"
                                                MaxLines="2"
                                                TextTrimming="CharacterEllipsis"
                                                Margin="0,0,0,6" />

                                            <!-- Embedded Snippet Boxes -->
                                            <ItemsControl Grid.Row="2" ItemsSource="{x:Bind Snippets, Mode=OneWay}" Margin="0,0,0,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SnippetBoxModel">
                                                        <Border
                                                            Margin="0,0,0,4"
                                                            Background="{StaticResource SnippetBoxBgBrush}"
                                                            BorderBrush="{StaticResource SnippetBoxBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="5"
                                                            Padding="8,6">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    Text="{x:Bind Content, Mode=OneWay}"
                                                                    FontFamily="{StaticResource CodeFontFamily}"
                                                                    FontSize="11"
                                                                    Foreground="#EEEEEE"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    MaxLines="2"
                                                                    VerticalAlignment="Center" />

                                                                <Button
                                                                    Grid.Column="1"
                                                                    Click="OnSnippetBoxCopyClick"
                                                                    Tag="{x:Bind Content, Mode=OneWay}"
                                                                    Height="22"
                                                                    Padding="6,0"
                                                                    Margin="6,0,0,0"
                                                                    Background="#15FFFFFF"
                                                                    BorderThickness="0"
                                                                    CornerRadius="3"
                                                                    VerticalAlignment="Center"
                                                                    ToolTipService.ToolTip="1-Click Copy snippet">
                                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                                        <FontIcon Glyph="&#xE8C8;" FontSize="8.5" />
                                                                        <TextBlock Text="Copy" FontSize="9" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Card Footer: Tag (#Work) & Snippet count (Secondary text) -->
                                            <Grid Grid.Row="3" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" Padding="0,5,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="2">
                                                    <TextBlock Text="#" FontSize="10" Foreground="#60CDFF" />
                                                    <TextBlock Text="{x:Bind Category, Mode=OneWay}" FontSize="10" Foreground="#AAAAAA" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind SnippetsCountText, Mode=OneWay}" FontSize="10" Foreground="#888888" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Column Splitter / Separator -->
        <Border Grid.Column="1" Width="1" Background="#15FFFFFF" />

        <!-- ====================================================================== -->
        <!-- 2. STICKY NOTE EDITOR PANE (Right Area)                                -->
        <!-- ====================================================================== -->
        <Border Grid.Column="2" Background="#202020">
            <controls:NoteEditorControl
                x:Name="HubEditorControl"
                Note="{x:Bind ViewModel.ActiveNote, Mode=OneWay}"
                IsFloatingMode="False"
                NewNoteRequested="OnNewNoteRequestedFromEditor"
                PopoutRequested="OnPopoutRequestedFromEditor"
                DeleteRequested="OnDeleteActiveNoteFromEditor"
                NoteSaved="OnActiveNoteSavedFromEditor" />
        </Border>
    </Grid>
</Page>
