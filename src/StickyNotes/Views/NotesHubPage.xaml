<Page
    x:Class="StickyNotes.Views.NotesHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:StickyNotes.Views.Converters"
    xmlns:models="using:StickyNotes.Core.Models.Note"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NoteBackgroundConverter x:Key="NoteBgConv" />
        <converters:NoteBorderConverter x:Key="NoteBorderConv" />
        <converters:NoteHeaderConverter x:Key="NoteHdrConv" />
        <converters:NoteAccentConverter x:Key="NoteAccentConv" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConv" />

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Page.Resources>

    <Grid Background="#121314">
        <!-- Main Workspace: Split into Hub (Left) and Floating Note Pane (Right) -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="380" MaxWidth="450" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- 1. MAIN STICKY NOTES HUB (Left Area)                      -->
        <!-- ========================================================= -->
        <Grid Grid.Column="0" Background="#181818">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Command Bar / Search & Primary Actions -->
            <Grid Grid.Row="0" Background="#232323" Padding="14,10" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Action buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button
                        Click="OnNewNoteClick"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="34"
                        Padding="14,0"
                        CornerRadius="5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="New note" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button
                        Click="OnSyncUpdatesClick"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Background="#2D2D2D"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="1"
                        CornerRadius="5"
                        ToolTipService.ToolTip="Check for updates in background">
                        <FontIcon Glyph="&#xE895;" FontSize="13" Foreground="#B0B0B0" />
                    </Button>
                </StackPanel>

                <!-- SearchBox -->
                <Grid Grid.Column="1" Margin="14,0" MaxWidth="320" HorizontalAlignment="Left">
                    <TextBox
                        x:Name="SearchBox"
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Search notes, commands, filepaths..."
                        Height="34"
                        FontSize="12"
                        Background="#2A2A2A"
                        BorderBrush="#1AFFFFFF"
                        CornerRadius="5"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- View Layout Switcher & Popout -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button
                        Click="OnToggleFloatingPaneClick"
                        Height="34"
                        Padding="10,0"
                        Background="#2D2D2D"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="1"
                        CornerRadius="5"
                        ToolTipService.ToolTip="Toggle Floating Note Editor">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A7;" FontSize="12" Foreground="#60CDFF" />
                            <TextBlock Text="Editor" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button
                        Click="OnOpenStandaloneWindowClick"
                        Height="34"
                        Padding="10,0"
                        Background="#2D2D2D"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="1"
                        CornerRadius="5"
                        ToolTipService.ToolTip="Pop out into separate Desktop Window">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7B5;" FontSize="12" Foreground="#F5C542" />
                            <TextBlock Text="Popout" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Workspace Body: Sidebar + Notes Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Sidebar -->
                <Grid Grid.Column="0" Background="#1B1B1B" BorderBrush="#12FFFFFF" BorderThickness="0,0,1,0" Padding="8,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4">
                        <!-- All Notes -->
                        <Button Click="OnFilterNavClick" Tag="all" Style="{StaticResource SidebarButtonStyle}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="#60CDFF" />
                                    <TextBlock Text="All Notes" FontWeight="SemiBold" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#20FFFFFF" CornerRadius="10" Padding="6,1">
                                    <TextBlock Text="{x:Bind ViewModel.AllCount, Mode=OneWay}" FontSize="10" Foreground="#AAAAAA" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Pinned -->
                        <Button Click="OnFilterNavClick" Tag="pinned" Style="{StaticResource SidebarButtonStyle}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE718;" FontSize="13" Foreground="#F5C542" />
                                    <TextBlock Text="Pinned" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#20FFFFFF" CornerRadius="10" Padding="6,1">
                                    <TextBlock Text="{x:Bind ViewModel.PinnedCount, Mode=OneWay}" FontSize="10" Foreground="#AAAAAA" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Work Category -->
                        <Button Click="OnFilterNavClick" Tag="work" Style="{StaticResource SidebarButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE821;" FontSize="13" Foreground="#888888" />
                                <TextBlock Text="Work" />
                            </StackPanel>
                        </Button>

                        <!-- Dev Category -->
                        <Button Click="OnFilterNavClick" Tag="dev" Style="{StaticResource SidebarButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE943;" FontSize="13" Foreground="#888888" />
                                <TextBlock Text="Dev" />
                            </StackPanel>
                        </Button>

                        <!-- Personal Category -->
                        <Button Click="OnFilterNavClick" Tag="personal" Style="{StaticResource SidebarButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE77B;" FontSize="13" Foreground="#888888" />
                                <TextBlock Text="Personal" />
                            </StackPanel>
                        </Button>

                        <MenuFlyoutSeparator Margin="0,8" />

                        <!-- Tags & Colors Section -->
                        <TextBlock Text="TAGS &amp; COLORS" FontSize="10" FontWeight="Bold" Foreground="#666666" Margin="6,4,0,6" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,0">
                            <Button Click="OnColorFilterClick" Tag="yellow" Width="18" Height="18" CornerRadius="9" Background="#F5C542" BorderBrush="#F5C542" Padding="0" ToolTipService.ToolTip="Deep Amber" />
                            <Button Click="OnColorFilterClick" Tag="blue" Width="18" Height="18" CornerRadius="9" Background="#60CDFF" BorderBrush="#60CDFF" Padding="0" ToolTipService.ToolTip="Midnight Blue" />
                            <Button Click="OnColorFilterClick" Tag="green" Width="18" Height="18" CornerRadius="9" Background="#6CCF8E" BorderBrush="#6CCF8E" Padding="0" ToolTipService.ToolTip="Emerald Sage" />
                            <Button Click="OnColorFilterClick" Tag="pink" Width="18" Height="18" CornerRadius="9" Background="#F48FB1" BorderBrush="#F48FB1" Padding="0" ToolTipService.ToolTip="Plum Pink" />
                            <Button Click="OnColorFilterClick" Tag="purple" Width="18" Height="18" CornerRadius="9" Background="#CE93D8" BorderBrush="#CE93D8" Padding="0" ToolTipService.ToolTip="Deep Lavender" />
                            <Button Click="OnColorFilterClick" Tag="gray" Width="18" Height="18" CornerRadius="9" Background="#888890" BorderBrush="#888890" Padding="0" ToolTipService.ToolTip="Graphite Charcoal" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom Status Indicator -->
                    <Border Grid.Row="1" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" Padding="4,8,4,0">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto,*">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#4ADE80" />
                                    <TextBlock Text="MSIX Auto-Update" FontSize="10" Foreground="#AAAAAA" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="v1.0.0" FontSize="10" FontWeight="SemiBold" Foreground="#60CDFF" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Notes Grid Container -->
                <Grid Grid.Column="1" Padding="18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CurrentCategoryTitle, Mode=OneWay}" FontWeight="Bold" FontSize="15" Foreground="White" />
                            <Border Background="#2560CDFF" BorderBrush="#4060CDFF" BorderThickness="1" CornerRadius="10" Padding="8,2" Visibility="{x:Bind ViewModel.HasActiveFilter, Mode=OneWay, Converter={StaticResource BoolToVisConv}}">
                                <TextBlock Text="Filter Active" FontSize="10" Foreground="#60CDFF" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="Click note to edit in Floating Window" FontSize="11" Foreground="#777777" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Cards ScrollViewer -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <GridView
                            ItemsSource="{x:Bind ViewModel.DisplayedNotes, Mode=OneWay}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="OnNoteCardItemClick">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:NoteModel">
                                    <Border
                                        Width="300"
                                        MinHeight="220"
                                        Margin="0,0,14,14"
                                        Background="{x:Bind ColorTheme, Mode=OneWay, Converter={StaticResource NoteBgConv}}"
                                        BorderBrush="{x:Bind ColorTheme, Mode=OneWay, Converter={StaticResource NoteBorderConv}}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14">
                                        <Grid RowDefinitions="Auto,*,Auto,Auto">
                                            <!-- Card Header: Title, Pin, Copy -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{x:Bind Title, Mode=OneWay}"
                                                    FontWeight="Bold"
                                                    FontSize="13"
                                                    Foreground="White"
                                                    TextTrimming="CharacterEllipsis" />

                                                <Button
                                                    Grid.Column="1"
                                                    Click="OnCardPinClick"
                                                    Tag="{x:Bind}"
                                                    Width="26"
                                                    Height="26"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    ToolTipService.ToolTip="Pin Note">
                                                    <FontIcon Glyph="&#xE718;" FontSize="11" Foreground="{x:Bind ColorTheme, Mode=OneWay, Converter={StaticResource NoteAccentConv}}" />
                                                </Button>

                                                <Button
                                                    Grid.Column="2"
                                                    Click="OnCardCopyAllClick"
                                                    Tag="{x:Bind}"
                                                    Height="26"
                                                    Padding="6,0"
                                                    Background="#15FFFFFF"
                                                    BorderThickness="0"
                                                    CornerRadius="4"
                                                    ToolTipService.ToolTip="Copy entire note">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="10" Foreground="#CCCCCC" />
                                                        <TextBlock Text="Copy" FontSize="10" Foreground="#CCCCCC" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- Content Text -->
                                            <TextBlock
                                                Grid.Row="1"
                                                Text="{x:Bind Content, Mode=OneWay}"
                                                FontSize="11.5"
                                                Foreground="#DDDDDD"
                                                TextWrapping="Wrap"
                                                MaxLines="3"
                                                TextTrimming="CharacterEllipsis"
                                                Margin="0,0,0,8" />

                                            <!-- Embedded Snippet Boxes -->
                                            <ItemsControl Grid.Row="2" ItemsSource="{x:Bind Snippets, Mode=OneWay}" Margin="0,0,0,8">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SnippetBoxModel">
                                                        <Border
                                                            Margin="0,0,0,6"
                                                            Background="{StaticResource SnippetBoxBgBrush}"
                                                            BorderBrush="{StaticResource SnippetBoxBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,6">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Grid.Column="0" Spacing="2">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <FontIcon Glyph="&#xE756;" FontSize="9" Foreground="#AAAAAA" />
                                                                        <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#AAAAAA" />
                                                                    </StackPanel>
                                                                    <TextBlock
                                                                        Text="{x:Bind Content, Mode=OneWay}"
                                                                        FontFamily="{StaticResource CodeFontFamily}"
                                                                        FontSize="11"
                                                                        Foreground="#EEEEEE"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        MaxLines="1" />
                                                                </StackPanel>

                                                                <Button
                                                                    Grid.Column="1"
                                                                    Click="OnSnippetBoxCopyClick"
                                                                    Tag="{x:Bind Content, Mode=OneWay}"
                                                                    Height="24"
                                                                    Padding="6,0"
                                                                    Background="#15FFFFFF"
                                                                    BorderThickness="0"
                                                                    CornerRadius="4"
                                                                    VerticalAlignment="Center"
                                                                    ToolTipService.ToolTip="1-Click Copy snippet">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <FontIcon Glyph="&#xE8C8;" FontSize="9" />
                                                                        <TextBlock Text="Copy" FontSize="9.5" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Card Footer: Category & Snippet count -->
                                            <Grid Grid.Row="3" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                                <TextBlock Text="{x:Bind Category, Mode=OneWay}" FontSize="10" Foreground="#888888" HorizontalAlignment="Left" />
                                                <TextBlock Text="{x:Bind SnippetsCountText, Mode=OneWay}" FontSize="10" Foreground="#60CDFF" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Dashboard Footer -->
            <Grid Grid.Row="2" Background="#161616" BorderBrush="#12FFFFFF" BorderThickness="0,1,0,0" Padding="16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.NotesCountText, Mode=OneWay}" FontWeight="SemiBold" FontSize="11" Foreground="#DDDDDD" />
                    <TextBlock Text="•" FontSize="11" Foreground="#555555" />
                    <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="#4ADE80" />
                    <TextBlock Text="Zero Data Loss Persistence Active" FontSize="11" Foreground="#4ADE80" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Windows App SDK 1.8" FontSize="10" Foreground="#666666" />
                    <TextBlock Text="•" FontSize="10" Foreground="#444444" />
                    <TextBlock Text="v1.0.0" FontSize="10" Foreground="#666666" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Column Splitter / Separator -->
        <Border Grid.Column="1" Width="1" Background="#15FFFFFF" />

        <!-- ====================================================================== -->
        <!-- 2. INDEPENDENT FLOATING STICKY NOTE WINDOW (Right Area)                -->
        <!-- ====================================================================== -->
        <Grid
            Grid.Column="2"
            Background="{x:Bind ViewModel.ActiveNote.ColorTheme, Mode=OneWay, Converter={StaticResource NoteBgConv}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Floating Note Header -->
            <Grid
                Grid.Row="0"
                Height="38"
                Background="{x:Bind ViewModel.ActiveNote.ColorTheme, Mode=OneWay, Converter={StaticResource NoteHdrConv}}"
                Padding="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: + New Note & Pin -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Click="OnNewNoteClick" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="New Note">
                        <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="White" />
                    </Button>
                    <AppBarSeparator />
                    <Button Click="OnToggleActiveNotePinClick" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Pin Note">
                        <FontIcon Glyph="&#xE718;" FontSize="11" Foreground="{x:Bind ViewModel.ActiveNote.ColorTheme, Mode=OneWay, Converter={StaticResource NoteAccentConv}}" />
                    </Button>
                </StackPanel>

                <!-- Center: Save status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <Ellipse Width="6" Height="6" Fill="#4ADE80" />
                    <TextBlock Text="{x:Bind ViewModel.SaveStatusText, Mode=OneWay}" FontSize="10.5" Foreground="#CCCCCC" />
                </StackPanel>

                <!-- Right: Popout into standalone window -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Click="OnOpenStandaloneWindowClick" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Pop out into separate window">
                        <FontIcon Glyph="&#xE7B5;" FontSize="10" Foreground="#AAAAAA" />
                    </Button>
                    <Button Click="OnDeleteActiveNoteClick" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Delete note">
                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#FF8888" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Floating Toolbar: +Box, Copy all, Color Theme Flyout -->
            <Grid Grid.Row="1" Height="36" Background="#20000000" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1" Padding="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Click="OnAddSnippetBoxToActiveClick" Style="{StaticResource DefaultButtonStyle}" Padding="8,4" Height="26">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE943;" FontSize="11" Foreground="#60CDFF" />
                            <TextBlock Text="+Box" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Click="OnCopyActiveNoteAllClick" Style="{StaticResource DefaultButtonStyle}" Padding="8,4" Height="26" ToolTipService.ToolTip="Copy note content and snippets">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8C8;" FontSize="10" />
                            <TextBlock x:Name="FloatingCopyAllText" Text="Copy all" FontSize="10.5" />
                        </StackPanel>
                    </Button>

                    <!-- Color palette selector -->
                    <Button Style="{StaticResource DefaultButtonStyle}" Padding="6,4" Height="26" ToolTipService.ToolTip="Select color theme">
                        <FontIcon Glyph="&#xE790;" FontSize="11" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                                    <Button Click="OnActiveColorSelectClick" Tag="yellow" Width="22" Height="22" CornerRadius="11" Background="#F5C542" BorderBrush="#F5C542" />
                                    <Button Click="OnActiveColorSelectClick" Tag="blue" Width="22" Height="22" CornerRadius="11" Background="#60CDFF" BorderBrush="#60CDFF" />
                                    <Button Click="OnActiveColorSelectClick" Tag="green" Width="22" Height="22" CornerRadius="11" Background="#6CCF8E" BorderBrush="#6CCF8E" />
                                    <Button Click="OnActiveColorSelectClick" Tag="pink" Width="22" Height="22" CornerRadius="11" Background="#F48FB1" BorderBrush="#F48FB1" />
                                    <Button Click="OnActiveColorSelectClick" Tag="purple" Width="22" Height="22" CornerRadius="11" Background="#CE93D8" BorderBrush="#CE93D8" />
                                    <Button Click="OnActiveColorSelectClick" Tag="gray" Width="22" Height="22" CornerRadius="11" Background="#888890" BorderBrush="#888890" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Editable Body: Title, Content, Dynamic Snippets -->
            <ScrollViewer Grid.Row="2" Padding="14,10" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <!-- Title -->
                    <TextBox
                        Text="{x:Bind ViewModel.ActiveNote.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Untitled Note..."
                        FontWeight="Bold"
                        FontSize="14"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0,4" />

                    <!-- Content -->
                    <TextBox
                        Text="{x:Bind ViewModel.ActiveNote.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Type note description or instructions here..."
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="50"
                        FontSize="12"
                        Foreground="#EEEEEE"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0,4" />

                    <!-- Dynamic Snippet Boxes Container -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveNote.Snippets, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SnippetBoxModel">
                                <Border
                                    Margin="0,0,0,8"
                                    Background="{StaticResource SnippetBoxBgBrush}"
                                    BorderBrush="{StaticResource SnippetBoxBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8">
                                    <StackPanel Spacing="6">
                                        <!-- Header: Type, Label, Copy & Delete -->
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <Border
                                                Grid.Column="0"
                                                Background="#2560CDFF"
                                                BorderBrush="#4060CDFF"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Margin="0,0,6,0">
                                                <TextBlock Text="{x:Bind Type, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#60CDFF" />
                                            </Border>

                                            <TextBox
                                                Grid.Column="1"
                                                Text="{x:Bind Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="Label (e.g. Build Command)"
                                                FontSize="11"
                                                Height="24"
                                                Padding="4,2"
                                                Background="Transparent"
                                                BorderThickness="0,0,0,1" />

                                            <Button
                                                Grid.Column="2"
                                                Click="OnActiveSnippetCopyClick"
                                                Tag="{x:Bind Content, Mode=OneWay}"
                                                Height="24"
                                                Padding="8,0"
                                                Margin="6,0,4,0"
                                                Style="{StaticResource DefaultButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="10" />
                                                    <TextBlock Text="Copy" FontSize="10" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                Grid.Column="3"
                                                Click="OnActiveSnippetRemoveClick"
                                                Tag="{x:Bind}"
                                                Width="24"
                                                Height="24"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="Remove snippet box">
                                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#FF8888" />
                                            </Button>
                                        </Grid>

                                        <!-- Monospace Content -->
                                        <TextBox
                                            Text="{x:Bind Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="// Enter command or snippet..."
                                            FontFamily="{StaticResource CodeFontFamily}"
                                            FontSize="11.5"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            Background="#15000000"
                                            BorderBrush="#10FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- + Add Copyable Box Button -->
                    <Button
                        Click="OnAddSnippetBoxToActiveClick"
                        HorizontalAlignment="Stretch"
                        Height="32"
                        Background="#10000000"
                        BorderBrush="#25FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="#60CDFF" />
                            <TextBlock Text="+ Add copyable box" FontSize="11" Foreground="#E0E0E0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Floating Window Status Bar -->
            <Grid Grid.Row="3" Height="24" Background="#15000000" BorderBrush="#10FFFFFF" BorderThickness="0,1,0,0" Padding="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.ActiveNoteSnippetCountText, Mode=OneWay}" FontSize="10" Foreground="#888888" />
                    <TextBlock Text="•" FontSize="10" Foreground="#555555" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveNoteCharCountText, Mode=OneWay}" FontSize="10" Foreground="#888888" />
                </StackPanel>

                <FontIcon Grid.Column="1" Glyph="&#xE90E;" FontSize="10" Foreground="#555555" VerticalAlignment="Center" ToolTipService.ToolTip="Floating note ready" />
            </Grid>
        </Grid>
    </Grid>
</Page>
