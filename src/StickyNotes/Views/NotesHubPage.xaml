<Page
    x:Class="StickyNotes.Views.NotesHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:StickyNotes.Core.Models.Note"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24,8,24,24">
        <!-- Top Action & Search Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
            <!-- New Note Button -->
            <Button
                Grid.Column="0"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnNewNoteClick"
                Height="36"
                Padding="16,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="New Note" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <!-- Search Box -->
            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                Margin="16,0"
                PlaceholderText="Search notes, tags, commands, or snippets..."
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Height="36"
                VerticalAlignment="Center" />

            <!-- Note count summary -->
            <TextBlock
                Grid.Column="2"
                Text="{x:Bind ViewModel.NotesCountText, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Category Filters -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled"
            Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="All" Tag="all" Click="OnFilterClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="14" Padding="14,4" />
                <Button Content="📌 Pinned" Tag="pinned" Click="OnFilterClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="14" Padding="14,4" />
                <Button Content="Work" Tag="work" Click="OnFilterClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="14" Padding="14,4" />
                <Button Content="Dev" Tag="dev" Click="OnFilterClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="14" Padding="14,4" />
                <Button Content="Personal" Tag="personal" Click="OnFilterClick" Style="{StaticResource DefaultButtonStyle}" CornerRadius="14" Padding="14,4" />
            </StackPanel>
        </ScrollViewer>

        <!-- Notes Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <GridView
                x:Name="NotesGridView"
                ItemsSource="{x:Bind ViewModel.DisplayedNotes, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="OnNoteItemClick">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:NoteModel">
                        <Border
                            Width="280"
                            MinHeight="200"
                            Margin="0,0,16,16"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">
                            <Grid RowDefinitions="Auto,*,Auto,Auto">
                                <!-- Card Header: Title & Pin/Delete actions -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind Title}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />
                                    
                                    <Button
                                        Grid.Column="1"
                                        Click="OnTogglePinClick"
                                        Tag="{x:Bind}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4"
                                        ToolTipService.ToolTip="Pin / Unpin">
                                        <FontIcon Glyph="&#xE718;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Button>

                                    <Button
                                        Grid.Column="2"
                                        Click="OnDeleteNoteClick"
                                        Tag="{x:Bind}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4"
                                        ToolTipService.ToolTip="Delete Note">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Button>
                                </Grid>

                                <!-- Note Content Description -->
                                <TextBlock
                                    Grid.Row="1"
                                    Text="{x:Bind Content}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    MaxLines="4"
                                    TextTrimming="CharacterEllipsis"
                                    Margin="0,0,0,12" />

                                <!-- Snippets List -->
                                <ItemsControl Grid.Row="2" ItemsSource="{x:Bind Snippets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:SnippetBoxModel">
                                            <Border
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,6"
                                                Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind Content}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="1"
                                                        Click="OnCopySnippetClick"
                                                        Tag="{x:Bind Content}"
                                                        VerticalAlignment="Center"
                                                        Padding="6,4"
                                                        ToolTipService.ToolTip="Copy snippet to clipboard">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Card Footer: Category & Date -->
                                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                    <Border
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="6,2">
                                        <TextBlock Text="{x:Bind Category}" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>
    </Grid>
</Page>
