<UserControl
    x:Class="StickyNotes.Views.Controls.NoteFloatingViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:StickyNotes.Views.Converters"
    xmlns:controls="using:StickyNotes.Views.Controls"
    xmlns:models="using:StickyNotes.Core.Models.Note"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:NoteBackgroundConverter x:Key="NoteBgConv" />
        <converters:NoteHeaderConverter x:Key="NoteHdrConv" />
        <converters:NoteAccentConverter x:Key="NoteAccentConv" />
        <converters:BoolToIntConverter x:Key="BoolToIntConv" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConv" />
    </UserControl.Resources>

    <Grid Background="{x:Bind Note.ColorTheme, Mode=OneWay, Converter={StaticResource NoteBgConv}}">
        <Grid.RowDefinitions>
            <!-- Floating Header Bar -->
            <RowDefinition Height="34" />
            <!-- Read-Only Content Body -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Floating Header Bar (Draggable) -->
        <Grid
            x:Name="HeaderBar"
            Grid.Row="0"
            Background="{x:Bind Note.ColorTheme, Mode=OneWay, Converter={StaticResource NoteHdrConv}}"
            Padding="10,0,8,0"
            PointerPressed="OnHeaderBarPointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Pin / Always on Top -->
            <Button
                Grid.Column="0"
                Click="OnTogglePinClick"
                Width="26"
                Height="26"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Pin (Always on Top)">
                <FontIcon Glyph="&#xE718;" FontSize="11" Foreground="{x:Bind Note.ColorTheme, Mode=OneWay, Converter={StaticResource NoteAccentConv}}" />
            </Button>

            <!-- Right: Minimize, Close -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!-- Minimize Window -->
                <Button
                    Click="OnMinimizeClick"
                    Width="24"
                    Height="24"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Minimize">
                    <FontIcon Glyph="&#xE921;" FontSize="10" Foreground="#AAAAAA" />
                </Button>

                <!-- Close Window -->
                <Button
                    Click="OnCloseClick"
                    Width="24"
                    Height="24"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#AAAAAA" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Read-Only Presentation Body -->
        <ScrollViewer Grid.Row="1" Padding="14,10" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" VerticalAlignment="Top">
                <!-- Title & Description Container (Supports Dynamic Reordering & Complete Hiding) -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title (Read-Only, Completely Collapsed when Hidden) -->
                    <TextBlock
                        Grid.Row="{x:Bind Note.IsContentFirst, Mode=OneWay, Converter={StaticResource BoolToIntConv}}"
                        Text="{x:Bind Note.DisplayTitle, Mode=OneWay}"
                        FontWeight="SemiBold"
                        FontSize="14.5"
                        Foreground="White"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Margin="0,0,0,4"
                        Visibility="{x:Bind Note.IsTitleMasked, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}" />

                    <!-- Note Body (Read-Only, Completely Collapsed when Hidden) -->
                    <TextBlock
                        Grid.Row="{x:Bind Note.IsContentFirst, Mode=OneWay, Converter={StaticResource BoolToIntConv}, ConverterParameter='Invert'}"
                        Text="{x:Bind Note.DisplayContent, Mode=OneWay}"
                        FontSize="12"
                        Foreground="#DDDDDD"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        LineHeight="17"
                        Margin="0,0,0,6"
                        Visibility="{x:Bind Note.IsContentMasked, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}" />
                </Grid>

                <!-- Dynamic Blocks (Snippets, Labels, Descriptions, Separators - Completely Collapsed when Hidden) -->
                <ItemsControl ItemsSource="{x:Bind Note.Snippets, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SnippetBoxModel">
                            <Grid Visibility="{x:Bind IsMasked, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}">
                                <!-- Separator View -->
                                <Border
                                    Height="1"
                                    Background="#25FFFFFF"
                                    Margin="0,4,0,6"
                                    Visibility="{x:Bind IsSeparator, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" />

                                <!-- Label View -->
                                <TextBlock
                                    Text="{x:Bind Content, Mode=OneWay}"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    Foreground="White"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    Margin="0,2,0,4"
                                    Visibility="{x:Bind IsLabel, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" />

                                <!-- Description View -->
                                <TextBlock
                                    Text="{x:Bind Content, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="#DDDDDD"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    LineHeight="17"
                                    Margin="0,2,0,6"
                                    Visibility="{x:Bind IsDescription, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" />

                                <!-- Snippet Box View -->
                                <Border
                                    Margin="0,0,0,6"
                                    Background="#1A000000"
                                    BorderBrush="#15FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6"
                                    Visibility="{x:Bind IsSnippet, Mode=OneWay, Converter={StaticResource BoolToVisConv}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <!-- Monospace Code / Command Text Content -->
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind Content, Mode=OneWay}"
                                            FontFamily="{StaticResource CodeFontFamily}"
                                            FontSize="11"
                                            Foreground="#FFFAE0"
                                            TextWrapping="Wrap"
                                            IsTextSelectionEnabled="True"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0" />

                                        <!-- Top-Right Inside-Block Icon-Only Copy Button -->
                                        <controls:CopyIconButton
                                            Grid.Column="1"
                                            TextToCopy="{x:Bind Content, Mode=OneWay}"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
