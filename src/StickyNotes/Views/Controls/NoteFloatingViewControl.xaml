<UserControl
    x:Class="StickyNotes.Views.Controls.NoteFloatingViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:StickyNotes.Views.Converters"
    xmlns:models="using:StickyNotes.Core.Models.Note"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:NoteBackgroundConverter x:Key="NoteBgConv" />
        <converters:NoteHeaderConverter x:Key="NoteHdrConv" />
        <converters:NoteAccentConverter x:Key="NoteAccentConv" />
    </UserControl.Resources>

    <Grid Background="{x:Bind Note.ColorTheme, Mode=OneWay, Converter={StaticResource NoteBgConv}}">
        <Grid.RowDefinitions>
            <!-- Floating Header Bar -->
            <RowDefinition Height="34" />
            <!-- Read-Only Content Body -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Floating Header Bar (Draggable) -->
        <Grid
            x:Name="HeaderBar"
            Grid.Row="0"
            Background="{x:Bind Note.ColorTheme, Mode=OneWay, Converter={StaticResource NoteHdrConv}}"
            Padding="10,0,8,0"
            PointerPressed="OnHeaderBarPointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Pin / Always on Top -->
            <Button
                Grid.Column="0"
                Click="OnTogglePinClick"
                Width="26"
                Height="26"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Pin (Always on Top)">
                <FontIcon Glyph="&#xE718;" FontSize="11" Foreground="{x:Bind Note.ColorTheme, Mode=OneWay, Converter={StaticResource NoteAccentConv}}" />
            </Button>

            <!-- Right: Copy All, Minimize, Close -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!-- Single Copy All Button for the whole note -->
                <Button
                    x:Name="CopyAllButton"
                    Click="OnCopyAllClick"
                    Height="24"
                    Padding="6,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Copy entire note &amp; blocks">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="11" Foreground="#CCCCCC" />
                        <TextBlock x:Name="CopyFeedbackText" Text="" FontSize="10" Foreground="#60CDFF" Visibility="Collapsed" />
                    </StackPanel>
                </Button>

                <!-- Minimize Window -->
                <Button
                    Click="OnMinimizeClick"
                    Width="24"
                    Height="24"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Minimize">
                    <FontIcon Glyph="&#xE921;" FontSize="10" Foreground="#AAAAAA" />
                </Button>

                <!-- Close Window -->
                <Button
                    Click="OnCloseClick"
                    Width="24"
                    Height="24"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#AAAAAA" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Read-Only Presentation Body -->
        <ScrollViewer Grid.Row="1" Padding="14,10" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" VerticalAlignment="Top">
                <!-- Title (Read-Only) -->
                <TextBlock
                    Text="{x:Bind Note.DisplayTitle, Mode=OneWay}"
                    FontWeight="SemiBold"
                    FontSize="14.5"
                    Foreground="White"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True" />

                <!-- Note Body (Read-Only) -->
                <TextBlock
                    Text="{x:Bind Note.Content, Mode=OneWay}"
                    FontSize="12"
                    Foreground="#DDDDDD"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True"
                    LineHeight="17" />

                <!-- Copyable Blocks (Read-Only Code / Command Content displayed sequentially) -->
                <ItemsControl ItemsSource="{x:Bind Note.Snippets, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SnippetBoxModel">
                            <Border
                                Margin="0,0,0,6"
                                Background="#1A000000"
                                BorderBrush="#15FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,6">
                                <TextBlock
                                    Text="{x:Bind Content, Mode=OneWay}"
                                    FontFamily="{StaticResource CodeFontFamily}"
                                    FontSize="11"
                                    Foreground="#FFFAE0"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
