<UserControl
    x:Class="StickyNotes.Views.Controls.CopyIconButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Name="ShowSuccessStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="CopyIcon"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0.15" />
            <DoubleAnimation
                Storyboard.TargetName="CopyIconScale"
                Storyboard.TargetProperty="ScaleX"
                To="0.6"
                Duration="0:0:0.15" />
            <DoubleAnimation
                Storyboard.TargetName="CopyIconScale"
                Storyboard.TargetProperty="ScaleY"
                To="0.6"
                Duration="0:0:0.15" />

            <DoubleAnimation
                Storyboard.TargetName="SuccessIcon"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="0:0:0.2" />
            <DoubleAnimation
                Storyboard.TargetName="SuccessIconScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.6"
                To="1"
                Duration="0:0:0.2" />
            <DoubleAnimation
                Storyboard.TargetName="SuccessIconScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.6"
                To="1"
                Duration="0:0:0.2" />
        </Storyboard>

        <Storyboard x:Name="ResetStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="SuccessIcon"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0.2" />
            <DoubleAnimation
                Storyboard.TargetName="SuccessIconScale"
                Storyboard.TargetProperty="ScaleX"
                To="0.6"
                Duration="0:0:0.2" />
            <DoubleAnimation
                Storyboard.TargetName="SuccessIconScale"
                Storyboard.TargetProperty="ScaleY"
                To="0.6"
                Duration="0:0:0.2" />

            <DoubleAnimation
                Storyboard.TargetName="CopyIcon"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="0:0:0.2" />
            <DoubleAnimation
                Storyboard.TargetName="CopyIconScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.6"
                To="1"
                Duration="0:0:0.2" />
            <DoubleAnimation
                Storyboard.TargetName="CopyIconScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.6"
                To="1"
                Duration="0:0:0.2" />
        </Storyboard>
    </UserControl.Resources>

    <Button
        x:Name="InnerButton"
        Click="OnButtonClick"
        Width="22"
        Height="22"
        Padding="0"
        Background="Transparent"
        BorderThickness="0"
        CornerRadius="3"
        ToolTipService.ToolTip="Copy">
        <Grid Width="16" Height="16">
            <FontIcon
                x:Name="CopyIcon"
                Glyph="&#xE8C8;"
                FontSize="11"
                Foreground="#88FFFFFF"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
                <FontIcon.RenderTransform>
                    <ScaleTransform x:Name="CopyIconScale" ScaleX="1" ScaleY="1" />
                </FontIcon.RenderTransform>
            </FontIcon>

            <FontIcon
                x:Name="SuccessIcon"
                Glyph="&#xE73E;"
                FontSize="11"
                Foreground="#4CCBA0"
                Opacity="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
                <FontIcon.RenderTransform>
                    <ScaleTransform x:Name="SuccessIconScale" ScaleX="0.6" ScaleY="0.6" />
                </FontIcon.RenderTransform>
            </FontIcon>
        </Grid>
    </Button>
</UserControl>
