<UserControl
    x:Class="StickyNotes.Views.Controls.NoteEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:StickyNotes.Views.Converters"
    xmlns:controls="using:StickyNotes.Views.Controls"
    xmlns:models="using:StickyNotes.Core.Models.Note"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:NoteBackgroundConverter x:Key="NoteBgConv" />
        <converters:NoteBorderConverter x:Key="NoteBorderConv" />
        <converters:NoteHeaderConverter x:Key="NoteHdrConv" />
        <converters:NoteAccentConverter x:Key="NoteAccentConv" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConv" />
        <converters:BoolToIntConverter x:Key="BoolToIntConv" />
        <converters:BoolToReorderGlyphConverter x:Key="BoolToReorderGlyphConv" />

        <!-- Subtle Delete Button: Muted by default, soft glowing red pill on hover -->
        <Style x:Key="SubtleDeleteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Foreground" Value="#60FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="#22FF5555" />
                                            <Setter Target="ContentPresenter.Foreground" Value="#FF7777" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="#33FF5555" />
                                            <Setter Target="ContentPresenter.Foreground" Value="#FFAAAA" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.3" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SixDotsIconTemplate">
            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="2">
                    <Ellipse Width="2.2" Height="2.2" Fill="#60FFFFFF" />
                    <Ellipse Width="2.2" Height="2.2" Fill="#60FFFFFF" />
                    <Ellipse Width="2.2" Height="2.2" Fill="#60FFFFFF" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <Ellipse Width="2.2" Height="2.2" Fill="#60FFFFFF" />
                    <Ellipse Width="2.2" Height="2.2" Fill="#60FFFFFF" />
                    <Ellipse Width="2.2" Height="2.2" Fill="#60FFFFFF" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{x:Bind Note.ColorTheme, Mode=OneWay, Converter={StaticResource NoteBgConv}}">
        <Grid.RowDefinitions>
            <!-- Note Header -->
            <RowDefinition Height="Auto" />
            <!-- Note Body ScrollViewer -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Grid
            x:Name="HeaderBar"
            Grid.Row="0"
            Height="36"
            Background="{x:Bind Note.ColorTheme, Mode=OneWay, Converter={StaticResource NoteHdrConv}}"
            Padding="12,0"
            PointerPressed="OnHeaderBarPointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Pin / Always on top -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Click="OnTogglePinClick" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="{x:Bind Note.PinToolTip, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind Note.PinGlyph, Mode=OneWay}" FontSize="12" Foreground="{x:Bind Note.ColorTheme, Mode=OneWay, Converter={StaticResource NoteAccentConv}}" Opacity="{x:Bind Note.PinOpacity, Mode=OneWay}" />
                </Button>
            </StackPanel>

            <!-- Center: Subtle Save Status -->
            <TextBlock
                Grid.Column="1"
                x:Name="SaveStatusLabel"
                Text="✓ Saved"
                FontSize="11"
                Foreground="#888888"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind IsFloatingMode, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}" />

            <!-- Right: Embedded Mode Actions (Color, Popout & Delete) -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center"
                Visibility="{x:Bind IsFloatingMode, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}">
                
                <!-- Note Color Palette -->
                <Button
                    Width="26"
                    Height="26"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Change note color">
                    <FontIcon Glyph="&#xE790;" FontSize="11" Foreground="#AAAAAA" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnColorSelectClick" Tag="yellow" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="11" Background="#F5C542" BorderBrush="#F5C542" ToolTipService.ToolTip="Yellow" />
                                <Button Click="OnColorSelectClick" Tag="blue" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="11" Background="#60CDFF" BorderBrush="#60CDFF" ToolTipService.ToolTip="Blue" />
                                <Button Click="OnColorSelectClick" Tag="green" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="11" Background="#6CCF8E" BorderBrush="#6CCF8E" ToolTipService.ToolTip="Green" />
                                <Button Click="OnColorSelectClick" Tag="pink" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="11" Background="#F48FB1" BorderBrush="#F48FB1" ToolTipService.ToolTip="Pink" />
                                <Button Click="OnColorSelectClick" Tag="purple" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="11" Background="#CE93D8" BorderBrush="#CE93D8" ToolTipService.ToolTip="Purple" />
                                <Button Click="OnColorSelectClick" Tag="gray" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="11" Background="#888890" BorderBrush="#888890" ToolTipService.ToolTip="Gray" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Popout to separate window -->
                <Button Click="OnPopoutClick" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Pop out into floating window">
                    <FontIcon Glyph="&#xE7B5;" FontSize="11" Foreground="#AAAAAA" />
                </Button>

                <!-- Delete note -->
                <Button Click="OnDeleteClick" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Delete note">
                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#FF8888" />
                </Button>
            </StackPanel>

            <!-- Right: Floating Mode Actions (Attach & Minimize) -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center"
                Visibility="{x:Bind IsFloatingMode, Mode=OneWay, Converter={StaticResource BoolToVisConv}}">
                <Button Click="OnAttachClick" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Attach / Dock back to Main Hub">
                    <FontIcon Glyph="&#xE7C3;" FontSize="11" Foreground="#60CDFF" />
                </Button>
                <Button Click="OnMinimizeClick" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Minimize">
                    <FontIcon Glyph="&#xE921;" FontSize="10" Foreground="#AAAAAA" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body: Compact Content-Driven Layout -->
        <ScrollViewer x:Name="EditorScrollViewer" Grid.Row="1" Padding="14,12" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Add title" Click="OnAddTitleClick"
                                    Visibility="{x:Bind Note.HasTitle, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8D2;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Add description" Click="OnAddDescriptionClick"
                                    Visibility="{x:Bind Note.HasContent, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8BD;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Add copyable box" Click="OnAddSnippetBoxClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE710;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Add label" Click="OnAddLabelBlockClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8EC;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Add separator" Click="OnAddSeparatorBlockClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE765;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
        </ScrollViewer.ContextFlyout>
        <StackPanel Spacing="4" VerticalAlignment="Top">
            <!-- Empty Note Prompt (shown if note has no items) -->
            <Button
                Click="OnAddTitleClick"
                HorizontalAlignment="Center"
                Margin="0,16,0,8"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#66FFFFFF"
                FontSize="11.5"
                Visibility="{x:Bind IsNoteEmpty, Mode=OneWay, Converter={StaticResource BoolToVisConv}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="10" />
                    <TextBlock Text="Click to add title or right-click to add blocks" />
                </StackPanel>
            </Button>

            <!-- Unified Modular Blocks List (Title, Description, Snippets, Labels, Separators) -->
            <ItemsControl x:Name="SnippetsItemsControl" ItemsSource="{x:Bind Note.Snippets, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SnippetBoxModel">
                        <Grid Margin="0,0,0,6">
                            <!-- 0. Title Block (Modular & Reorderable) -->
                            <Grid Visibility="{x:Bind IsTitle, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 6-Dot Drag Handle -->
                                <Border
                                    Grid.Column="0"
                                    Tag="{x:Bind}"
                                    Width="20"
                                    Height="24"
                                    Padding="0"
                                    Margin="0,0,6,0"
                                    Background="Transparent"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    PointerEntered="OnGripPointerEntered"
                                    PointerExited="OnGripPointerExited"
                                    PointerPressed="OnGripPointerPressed"
                                    ToolTipService.ToolTip="Drag to reorder (click for options)">
                                    <ContentControl ContentTemplate="{StaticResource SixDotsIconTemplate}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Title (Editable when unmasked) -->
                                <TextBox
                                    Grid.Column="1"
                                    Text="{x:Bind Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Untitled Note"
                                    FontWeight="SemiBold"
                                    FontSize="14.5"
                                    Foreground="White"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0,2"
                                    Tag="{x:Bind}"
                                    TextChanged="OnSnippetContentChanged"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind IsMasked, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}" />

                                <!-- Title (Editable PasswordBox when masked) -->
                                <PasswordBox
                                    Grid.Column="1"
                                    Password="{x:Bind Content, Mode=OneWay}"
                                    PasswordChanged="OnSnippetPasswordChanged"
                                    Tag="{x:Bind}"
                                    PlaceholderText="Enter secret title..."
                                    FontWeight="SemiBold"
                                    FontSize="14.5"
                                    Foreground="White"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0,2"
                                    PasswordRevealMode="Hidden"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind IsMasked, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" />

                                <!-- Title Hide/Unhide Toggle Button -->
                                <Button
                                    Grid.Column="2"
                                    Click="OnSnippetToggleMaskClick"
                                    Tag="{x:Bind}"
                                    Width="22"
                                    Height="22"
                                    Padding="0"
                                    Margin="2,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{x:Bind MaskToolTip, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind MaskGlyph, Mode=OneWay}" FontSize="9.5" Foreground="#77FFFFFF" />
                                </Button>

                                <!-- Delete Title Button -->
                                <Button
                                    Grid.Column="3"
                                    Style="{StaticResource SubtleDeleteButtonStyle}"
                                    Click="OnSnippetRemoveClick"
                                    Tag="{x:Bind}"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Delete title">
                                    <FontIcon Glyph="&#xE711;" FontSize="9" />
                                </Button>
                            </Grid>

                            <!-- 1. Separator Block -->
                            <Grid Visibility="{x:Bind IsSeparator, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 6-Dot Drag Handle -->
                                    <Border
                                        Grid.Column="0"
                                        Tag="{x:Bind}"
                                        Width="20"
                                        Height="24"
                                        Padding="0"
                                        Margin="0,0,6,0"
                                        Background="Transparent"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        PointerEntered="OnGripPointerEntered"
                                        PointerExited="OnGripPointerExited"
                                        PointerPressed="OnGripPointerPressed"
                                        ToolTipService.ToolTip="Drag to reorder (click for options)">
                                        <ContentControl ContentTemplate="{StaticResource SixDotsIconTemplate}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Separator Line with Editable Center Text -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Height="1" Background="#35FFFFFF" VerticalAlignment="Center" />
                                        <TextBox
                                            Grid.Column="1"
                                            Text="{x:Bind Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="─── Divider label (optional) ───"
                                            HorizontalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="8,1"
                                            FontSize="10.5"
                                            Foreground="#AAAAAA"
                                            TextChanged="OnContentChanged" />
                                        <Border Grid.Column="2" Height="1" Background="#35FFFFFF" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Delete Button -->
                                    <Button
                                        Grid.Column="2"
                                        Style="{StaticResource SubtleDeleteButtonStyle}"
                                        Click="OnSnippetRemoveClick"
                                        Tag="{x:Bind}"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Remove separator">
                                        <FontIcon Glyph="&#xE711;" FontSize="9" />
                                    </Button>
                                </Grid>

                                <!-- 2. Label Block -->
                                <Grid Visibility="{x:Bind IsLabel, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 6-Dot Drag Handle -->
                                    <Border
                                        Grid.Column="0"
                                        Tag="{x:Bind}"
                                        Width="20"
                                        Height="24"
                                        Padding="0"
                                        Margin="0,0,6,0"
                                        Background="Transparent"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        PointerEntered="OnGripPointerEntered"
                                        PointerExited="OnGripPointerExited"
                                        PointerPressed="OnGripPointerPressed"
                                        ToolTipService.ToolTip="Drag to reorder (click for options)">
                                        <ContentControl ContentTemplate="{StaticResource SixDotsIconTemplate}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <TextBox
                                        Grid.Column="1"
                                        Text="{x:Bind Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Label heading..."
                                        FontWeight="SemiBold"
                                        FontSize="13.5"
                                        Foreground="#FFFFFF"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0,2"
                                        TextChanged="OnContentChanged"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind IsMasked, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}" />
                                    <PasswordBox
                                        Grid.Column="1"
                                        Password="{x:Bind Content, Mode=OneWay}"
                                        PasswordChanged="OnSnippetPasswordChanged"
                                        Tag="{x:Bind}"
                                        PlaceholderText="Secret label..."
                                        FontWeight="SemiBold"
                                        FontSize="13.5"
                                        Foreground="#FFFFFF"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0,2"
                                        PasswordRevealMode="Hidden"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind IsMasked, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" />
                                    <Button
                                        Grid.Column="2"
                                        Click="OnSnippetToggleMaskClick"
                                        Tag="{x:Bind}"
                                        Width="20"
                                        Height="20"
                                        Padding="0"
                                        Margin="4,0,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{x:Bind MaskToolTip, Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind MaskGlyph, Mode=OneWay}" FontSize="9" Foreground="#AAAAAA" />
                                    </Button>
                                    <Button
                                        Grid.Column="3"
                                        Style="{StaticResource SubtleDeleteButtonStyle}"
                                        Click="OnSnippetRemoveClick"
                                        Tag="{x:Bind}"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Remove label">
                                        <FontIcon Glyph="&#xE711;" FontSize="9" />
                                    </Button>
                                </Grid>

                                <!-- 3. Description Block -->
                                <Grid Visibility="{x:Bind IsDescription, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 6-Dot Drag Handle -->
                                    <Border
                                        Grid.Column="0"
                                        Tag="{x:Bind}"
                                        Width="20"
                                        Height="24"
                                        Padding="0"
                                        Margin="0,0,6,0"
                                        Background="Transparent"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        PointerEntered="OnGripPointerEntered"
                                        PointerExited="OnGripPointerExited"
                                        PointerPressed="OnGripPointerPressed"
                                        ToolTipService.ToolTip="Drag to reorder (click for options)">
                                        <ContentControl ContentTemplate="{StaticResource SixDotsIconTemplate}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <TextBox
                                        Grid.Column="1"
                                        Text="{x:Bind Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Additional description or instructions..."
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="36"
                                        FontSize="12"
                                        Foreground="#DDDDDD"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0,2"
                                        Tag="{x:Bind}"
                                        TextChanged="OnSnippetContentChanged"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind IsMasked, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}" />
                                    <PasswordBox
                                        Grid.Column="1"
                                        Password="{x:Bind Content, Mode=OneWay}"
                                        PasswordChanged="OnSnippetPasswordChanged"
                                        Tag="{x:Bind}"
                                        PlaceholderText="Secret description..."
                                        FontSize="12"
                                        Foreground="#DDDDDD"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0,2"
                                        PasswordRevealMode="Hidden"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind IsMasked, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" />
                                    <Button
                                        Grid.Column="2"
                                        Click="OnSnippetToggleMaskClick"
                                        Tag="{x:Bind}"
                                        Width="20"
                                        Height="20"
                                        Padding="0"
                                        Margin="4,0,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{x:Bind MaskToolTip, Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind MaskGlyph, Mode=OneWay}" FontSize="9" Foreground="#AAAAAA" />
                                    </Button>
                                    <Button
                                        Grid.Column="3"
                                        Style="{StaticResource SubtleDeleteButtonStyle}"
                                        Click="OnSnippetRemoveClick"
                                        Tag="{x:Bind}"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Remove description">
                                        <FontIcon Glyph="&#xE711;" FontSize="9" />
                                    </Button>
                                </Grid>

                                <!-- 4. Copyable Snippet Box -->
                                <Border
                                    Visibility="{x:Bind IsSnippet, Mode=OneWay, Converter={StaticResource BoolToVisConv}}"
                                    Background="{StaticResource SnippetBoxBgBrush}"
                                    BorderBrush="{StaticResource SnippetBoxBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="6,6,8,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                                        <!-- 6-Dot Drag Handle -->
                                        <Border
                                            Grid.Column="0"
                                            Tag="{x:Bind}"
                                            Width="20"
                                            Height="24"
                                            Padding="0"
                                            Margin="0,0,6,0"
                                            Background="Transparent"
                                            CornerRadius="3"
                                            VerticalAlignment="Center"
                                            PointerEntered="OnGripPointerEntered"
                                            PointerExited="OnGripPointerExited"
                                            PointerPressed="OnGripPointerPressed"
                                            ToolTipService.ToolTip="Drag to reorder (click for options)">
                                            <ContentControl ContentTemplate="{StaticResource SixDotsIconTemplate}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Monospace Code / Command Text Area (when unmasked) -->
                                        <TextBox
                                            Grid.Column="1"
                                            Text="{x:Bind Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Enter command or snippet..."
                                            FontFamily="{StaticResource CodeFontFamily}"
                                            FontSize="11"
                                            Foreground="#FFFAE0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            TextChanged="OnContentChanged"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind IsMasked, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}" />

                                        <!-- Password Box (when masked) -->
                                        <PasswordBox
                                            Grid.Column="1"
                                            Password="{x:Bind Content, Mode=OneWay}"
                                            PasswordChanged="OnSnippetPasswordChanged"
                                            Tag="{x:Bind}"
                                            PlaceholderText="Enter secret snippet..."
                                            FontFamily="{StaticResource CodeFontFamily}"
                                            FontSize="11"
                                            Foreground="#FFFAE0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            PasswordRevealMode="Hidden"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind IsMasked, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" />

                                        <!-- Hide / Unhide Toggle Button -->
                                        <Button
                                            Grid.Column="2"
                                            Click="OnSnippetToggleMaskClick"
                                            Tag="{x:Bind}"
                                            Width="20"
                                            Height="20"
                                            Padding="0"
                                            Margin="4,0,0,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind MaskToolTip, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind MaskGlyph, Mode=OneWay}" FontSize="9" Foreground="#AAAAAA" />
                                        </Button>

                                        <!-- 1-Click Copy Button (Icon only) -->
                                        <controls:CopyIconButton
                                            Grid.Column="3"
                                            TextToCopy="{x:Bind Content, Mode=OneWay}"
                                            Margin="2,0,2,0"
                                            VerticalAlignment="Center" />

                                        <!-- Remove Block Button -->
                                        <Button
                                            Grid.Column="4"
                                            Style="{StaticResource SubtleDeleteButtonStyle}"
                                            Click="OnSnippetRemoveClick"
                                            Tag="{x:Bind}"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Remove block">
                                            <FontIcon Glyph="&#xE711;" FontSize="9" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
