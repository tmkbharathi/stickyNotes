<UserControl
    x:Class="StickyNotes.Views.Controls.NoteEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:StickyNotes.Views.Converters"
    xmlns:models="using:StickyNotes.Core.Models.Note"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:NoteBackgroundConverter x:Key="NoteBgConv" />
        <converters:NoteBorderConverter x:Key="NoteBorderConv" />
        <converters:NoteHeaderConverter x:Key="NoteHdrConv" />
        <converters:NoteAccentConverter x:Key="NoteAccentConv" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConv" />
    </UserControl.Resources>

    <Grid Background="{x:Bind Note.ColorTheme, Mode=OneWay, Converter={StaticResource NoteBgConv}}">
        <Grid.RowDefinitions>
            <!-- Note Header -->
            <RowDefinition Height="Auto" />
            <!-- Note Body ScrollViewer -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Grid
            x:Name="HeaderBar"
            Grid.Row="0"
            Height="36"
            Background="{x:Bind Note.ColorTheme, Mode=OneWay, Converter={StaticResource NoteHdrConv}}"
            Padding="12,0"
            PointerPressed="OnHeaderBarPointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Pin / Always on top -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Click="OnTogglePinClick" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Pin Note">
                    <FontIcon Glyph="&#xE718;" FontSize="11" Foreground="{x:Bind Note.ColorTheme, Mode=OneWay, Converter={StaticResource NoteAccentConv}}" />
                </Button>
            </StackPanel>

            <!-- Center: Subtle Save Status -->
            <TextBlock
                Grid.Column="1"
                x:Name="SaveStatusLabel"
                Text="✓ Saved"
                FontSize="11"
                Foreground="#888888"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind IsFloatingMode, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}" />

            <!-- Right: Embedded Mode Actions (Color, Popout & Delete) -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center"
                Visibility="{x:Bind IsFloatingMode, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}">
                
                <!-- Note Color Palette -->
                <Button
                    Width="26"
                    Height="26"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Change note color">
                    <FontIcon Glyph="&#xE790;" FontSize="11" Foreground="#AAAAAA" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                                <Button Click="OnColorSelectClick" Tag="yellow" Width="22" Height="22" CornerRadius="11" Background="#F5C542" BorderBrush="#F5C542" ToolTipService.ToolTip="Yellow" />
                                <Button Click="OnColorSelectClick" Tag="blue" Width="22" Height="22" CornerRadius="11" Background="#60CDFF" BorderBrush="#60CDFF" ToolTipService.ToolTip="Blue" />
                                <Button Click="OnColorSelectClick" Tag="green" Width="22" Height="22" CornerRadius="11" Background="#6CCF8E" BorderBrush="#6CCF8E" ToolTipService.ToolTip="Green" />
                                <Button Click="OnColorSelectClick" Tag="pink" Width="22" Height="22" CornerRadius="11" Background="#F48FB1" BorderBrush="#F48FB1" ToolTipService.ToolTip="Pink" />
                                <Button Click="OnColorSelectClick" Tag="purple" Width="22" Height="22" CornerRadius="11" Background="#CE93D8" BorderBrush="#CE93D8" ToolTipService.ToolTip="Purple" />
                                <Button Click="OnColorSelectClick" Tag="gray" Width="22" Height="22" CornerRadius="11" Background="#888890" BorderBrush="#888890" ToolTipService.ToolTip="Gray" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Popout to separate window -->
                <Button Click="OnPopoutClick" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Pop out into floating window">
                    <FontIcon Glyph="&#xE7B5;" FontSize="11" Foreground="#AAAAAA" />
                </Button>

                <!-- Delete note -->
                <Button Click="OnDeleteClick" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Delete note">
                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#FF8888" />
                </Button>
            </StackPanel>

            <!-- Right: Floating Mode Actions (Attach & Minimize) -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center"
                Visibility="{x:Bind IsFloatingMode, Mode=OneWay, Converter={StaticResource BoolToVisConv}}">
                <Button Click="OnAttachClick" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Attach / Dock back to Main Hub">
                    <FontIcon Glyph="&#xE7C3;" FontSize="11" Foreground="#60CDFF" />
                </Button>
                <Button Click="OnMinimizeClick" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Minimize">
                    <FontIcon Glyph="&#xE921;" FontSize="10" Foreground="#AAAAAA" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body: Compact Content-Driven Layout -->
        <ScrollViewer Grid.Row="1" Padding="14,12" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4" VerticalAlignment="Top">
                <!-- Title (Editable in Embedded Mode) -->
                <TextBox
                    x:Name="TitleTextBox"
                    Text="{x:Bind Note.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Untitled Note"
                    FontWeight="SemiBold"
                    FontSize="14.5"
                    Foreground="White"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0,2"
                    TextChanged="OnContentChanged"
                    Visibility="{x:Bind IsFloatingMode, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}" />

                <!-- Title (Read-only in Floating Mode) -->
                <TextBlock
                    Text="{x:Bind Note.DisplayTitle, Mode=OneWay}"
                    FontWeight="SemiBold"
                    FontSize="14.5"
                    Foreground="White"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True"
                    Visibility="{x:Bind IsFloatingMode, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" />

                <!-- Content (Editable in Embedded Mode) -->
                <TextBox
                    x:Name="ContentTextBox"
                    Text="{x:Bind Note.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Type note text or instructions..."
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="38"
                    FontSize="12"
                    Foreground="#DDDDDD"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0,2"
                    Margin="0,0,0,2"
                    TextChanged="OnContentChanged"
                    Visibility="{x:Bind IsFloatingMode, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}" />

                <!-- Content (Read-only in Floating Mode) -->
                <TextBlock
                    Text="{x:Bind Note.Content, Mode=OneWay}"
                    FontSize="12"
                    Foreground="#CCCCCC"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True"
                    LineHeight="17"
                    Margin="0,0,0,2"
                    Visibility="{x:Bind IsFloatingMode, Mode=OneWay, Converter={StaticResource BoolToVisConv}}" />

                <!-- Section Divider -->
                <Border Height="1" Background="#15FFFFFF" Margin="0,6,0,8" />

                <!-- Copyable Blocks Section Header & Copy All Blocks -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="COPYABLE BLOCKS" FontSize="10" FontWeight="Bold" Foreground="#777777" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Click="OnCopyAllClick" Height="22" Padding="6,0" Background="#15FFFFFF" BorderThickness="0" CornerRadius="3" ToolTipService.ToolTip="Copy all blocks to clipboard">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8C8;" FontSize="9" />
                            <TextBlock x:Name="CopyAllText" Text="Copy all blocks" FontSize="10" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Snippet Blocks List -->
                <ItemsControl ItemsSource="{x:Bind Note.Snippets, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SnippetBoxModel">
                            <Border
                                Margin="0,0,0,6"
                                Background="{StaticResource SnippetBoxBgBrush}"
                                BorderBrush="{StaticResource SnippetBoxBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8,6">
                                <StackPanel Spacing="4">
                                    <!-- Top Row: Type, Label, Copy & Delete -->
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <!-- Type Badge -->
                                        <Border
                                            Grid.Column="0"
                                            Background="#2560CDFF"
                                            BorderBrush="#4060CDFF"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="0,0,6,0">
                                            <TextBlock Text="{x:Bind Type, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#60CDFF" />
                                        </Border>

                                        <!-- Label -->
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind Label, Mode=OneWay}"
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="#BBBBBB"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />

                                        <!-- 1-Click Copy Button -->
                                        <Button
                                            Grid.Column="2"
                                            Click="OnSnippetCopyClick"
                                            Tag="{x:Bind Content, Mode=OneWay}"
                                            Height="22"
                                            Padding="6,0"
                                            Margin="4,0,2,0"
                                            Background="#20FFFFFF"
                                            BorderThickness="0"
                                            CornerRadius="3">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="9" />
                                                <TextBlock Text="Copy" FontSize="9.5" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Remove Snippet Button (only in edit mode) -->
                                        <Button
                                            Grid.Column="3"
                                            Click="OnSnippetRemoveClick"
                                            Tag="{x:Bind}"
                                            Width="22"
                                            Height="22"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ToolTipService.ToolTip="Remove block">
                                            <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="#FF8888" />
                                        </Button>
                                    </Grid>

                                    <!-- Monospace Code / Command Snippet Content -->
                                    <Border
                                        Background="#12000000"
                                        BorderBrush="#10FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="6,4">
                                        <TextBlock
                                            Text="{x:Bind Content, Mode=OneWay}"
                                            FontFamily="{StaticResource CodeFontFamily}"
                                            FontSize="11"
                                            Foreground="#FFFAE0"
                                            TextWrapping="Wrap"
                                            IsTextSelectionEnabled="True" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- + Add Copyable Box Button (Single Button at Bottom) -->
                <Button
                    Click="OnAddSnippetBoxClick"
                    HorizontalAlignment="Stretch"
                    Height="28"
                    Background="#10000000"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="1"
                    CornerRadius="5"
                    Margin="0,2,0,0"
                    Visibility="{x:Bind IsFloatingMode, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter='Invert'}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="#60CDFF" />
                        <TextBlock Text="+ Add copyable box" FontSize="11" Foreground="#CCCCCC" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
