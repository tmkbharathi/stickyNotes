<Page
    x:Class="StickyNotes.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#101112">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <StackPanel
                MaxWidth="800"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="24"
                Spacing="24">
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Click="OnBackClick" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Back to Notes">
                        <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="White" />
                    </Button>
                    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <!-- General & Startup Section Card -->
                <StackPanel Spacing="12" VerticalAlignment="Top">
                    <TextBlock Text="Startup &amp; Preferences" FontSize="14" FontWeight="SemiBold" Foreground="#CCCCCC" />

                    <Border
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        VerticalAlignment="Top">
                        <StackPanel Spacing="16" VerticalAlignment="Top">
                            <ToggleSwitch
                                Header="Start Sticky Notes with Windows"
                                IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Updates Section Card -->
                <StackPanel Spacing="12" VerticalAlignment="Top">
                    <TextBlock Text="Updates" FontSize="14" FontWeight="SemiBold" Foreground="#CCCCCC" />

                    <Border
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        VerticalAlignment="Top">
                        <StackPanel Spacing="16" VerticalAlignment="Top">
                            <!-- Current Version & Status Row -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Sticky Notes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.FormattedVersion, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.FormattedLastCheckedText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Content="Check for updates"
                                    Style="{StaticResource AccentButtonStyle}"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <!-- Toggles -->
                            <ToggleSwitch
                                Header="Automatically check for updates"
                                IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}" />

                            <ToggleSwitch
                                Header="Download updates automatically"
                                IsOn="{x:Bind ViewModel.AutoDownloadUpdates, Mode=TwoWay}" />

                            <ToggleSwitch
                                Header="Install updates automatically when safe"
                                IsOn="{x:Bind ViewModel.AutoInstallWhenSafe, Mode=TwoWay}" />

                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
