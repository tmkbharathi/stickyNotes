<Page
    x:Class="StickyNotes.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:StickyNotes.Views.Converters"
    mc:Ignorable="d"
    RequestedTheme="Dark">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConv" />
    </Page.Resources>

    <Grid Background="#101112">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <StackPanel
                MaxWidth="800"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Padding="24,20,24,32"
                Spacing="24">

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button
                        Click="OnBackClick"
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6"
                        ToolTipService.ToolTip="Back to Notes">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" Foreground="White" />
                    </Button>
                    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Section 1: General & Startup -->
                <StackPanel Spacing="8" VerticalAlignment="Top">
                    <TextBlock Text="Startup &amp; Preferences" FontSize="13" FontWeight="SemiBold" Foreground="#888888" Margin="4,0,0,0" />

                    <Border
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7E8;" FontSize="18" Foreground="#CCCCCC" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Start Sticky Notes with Windows" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Automatically start the app in the background when you sign in to Windows"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                                OnContent=""
                                OffContent=""
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Section 2: Updates -->
                <StackPanel Spacing="8" VerticalAlignment="Top">
                    <TextBlock Text="Updates" FontSize="13" FontWeight="SemiBold" Foreground="#888888" Margin="4,0,0,0" />

                    <Border
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        HorizontalAlignment="Stretch">
                        <StackPanel Spacing="14">
                            <!-- Current Version & Status Row -->
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE895;" FontSize="20" Foreground="#60CDFF" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Sticky Notes Updates" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.FormattedVersion, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.FormattedLastCheckedText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <ProgressRing
                                        IsActive="{x:Bind ViewModel.IsChecking, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsChecking, Mode=OneWay, Converter={StaticResource BoolToVisConv}}"
                                        Width="20"
                                        Height="20" />
                                    <Button
                                        Content="Check for updates"
                                        Style="{StaticResource AccentButtonStyle}"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.CheckForUpdatesCommand, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <!-- Download Progress Row (Visible while downloading) -->
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisConv}}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Downloading update package..."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="Cancel"
                                            Style="{StaticResource DefaultButtonStyle}"
                                            Command="{x:Bind ViewModel.CancelDownloadCommand, Mode=OneWay}"
                                            Padding="10,3"
                                            FontSize="12" />
                                </Grid>
                                <ProgressBar Value="{x:Bind ViewModel.DownloadProgressPercentage, Mode=OneWay}" Maximum="100" Height="4" />
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <!-- Automatically Check for Updates -->
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="#CCCCCC" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Automatically check for updates" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="Periodically check for new releases in the background"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <!-- Automatically Download Updates -->
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE898;" FontSize="16" Foreground="#CCCCCC" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Automatically download updates" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="Download installer packages in the background when available"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    IsOn="{x:Bind ViewModel.AutoDownloadUpdates, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <!-- Auto-Install When Safe -->
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE90A;" FontSize="16" Foreground="#CCCCCC" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Install updates when safe" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="Apply updates seamlessly while the app is idle or upon restart"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    IsOn="{x:Bind ViewModel.AutoInstallWhenSafe, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <!-- Release Channel Selection -->
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE912;" FontSize="16" Foreground="#CCCCCC" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Update channel" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="Choose between Stable (recommended), Beta, and Development streams"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="2"
                                    ItemsSource="{x:Bind ViewModel.AvailableChannels}"
                                    SelectedIndex="{x:Bind ViewModel.SelectedChannelIndex, Mode=TwoWay}"
                                    MinWidth="140"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 3: About -->
                <StackPanel Spacing="8" VerticalAlignment="Top">
                    <TextBlock Text="About" FontSize="13" FontWeight="SemiBold" Foreground="#888888" Margin="4,0,0,0" />

                    <Border
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        HorizontalAlignment="Stretch">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE70F;" FontSize="28" Foreground="#F5C542" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Sticky Notes" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{x:Bind ViewModel.FormattedVersion, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="A lightweight, modern sticky notes application for Windows with cloud sync and floating note capabilities."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <HyperlinkButton NavigateUri="https://github.com/tmkbharathi/stickyNotes" Padding="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                        <TextBlock Text="GitHub Repository" FontSize="12" />
                                    </StackPanel>
                                </HyperlinkButton>

                                <HyperlinkButton NavigateUri="https://github.com/tmkbharathi/stickyNotes/issues" Padding="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE939;" FontSize="13" />
                                        <TextBlock Text="Report an Issue" FontSize="12" />
                                    </StackPanel>
                                </HyperlinkButton>

                                <HyperlinkButton NavigateUri="https://github.com/tmkbharathi/stickyNotes/releases" Padding="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE81C;" FontSize="13" />
                                        <TextBlock Text="Release Notes" FontSize="12" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
